{
  "name": "anveinspect-monorepo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "AnveInspect — plug-and-play fleet control plane for AI coding agents: discovery, lineage, inventory, and silent-failure alerting across Claude Code, Codex, OpenClaw, Hermes, Bedrock, Vertex, Foundry, and Cloudflare.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "dashboard"
  ],
  "bin": {
    "anveinspect": "packages/collector/bin/anveinspect.mjs"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "tsx packages/collector/src/cli.ts doctor",
    "scan": "tsx packages/collector/src/cli.ts scan",
    "dash": "tsx dashboard/server.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
