{
  "name": "anveinspect-monorepo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Agent fleet control plane — discovery, lineage & inventory for coding agents (working codename)",
  "workspaces": [
    "packages/*",
    "dashboard"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "scan": "tsx packages/collector/src/cli.ts scan",
    "dash": "tsx dashboard/server.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
